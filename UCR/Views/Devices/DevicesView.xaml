<UserControl x:Class="HidWizards.UCR.Views.Devices.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:devices="clr-namespace:HidWizards.UCR.ViewModels.Devices"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="{DynamicResource MaterialDesignPaper}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- SELECTED SCOPE'S GAME PROFILE. Shown once a single device or a group is selected as the
             Mapping target (DevicesViewModel.CurrentScope) — lets the user see, choose/create, and
             edit that scope's associated profile without leaving the Devices tab. -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="12"
                              Visibility="{Binding HasSelectedScope, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedScopeDisplayName, StringFormat='Selected: {0}'}" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding AssociatedProfileName, StringFormat='Profile: {0}'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAssociatedProfile}" Value="False">
                                        <Setter Property="Text" Value="No Game Profile yet — choose or create one to begin mapping." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding EditProfileCommand}" ToolTip="Edit profile"
                        Style="{StaticResource MaterialDesignToolButton}" Margin="8,0,0,0"
                        Visibility="{Binding HasAssociatedProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="Pencil" />
                </Button>
                <Button Grid.Column="2" Content="CHOOSE / CREATE PROFILE" Command="{Binding ChooseProfileCommand}" Margin="8,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAssociatedProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </materialDesign:Card>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <!-- Left Column: Detected Devices -->
            <ColumnDefinition Width="5*" />
            <!-- Divider -->
            <ColumnDefinition Width="16" />
            <!-- Right Column: Groups -->
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DETECTED DEVICES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignToolButton}" ToolTip="Rescan for devices connected after startup"
                            Padding="0" Width="24" Height="24" Margin="0,0,4,0"
                            Command="{Binding RescanDevicesCommand}">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" ToolTip="Manage all devices (rename, hide, remove, reorder)"
                            Padding="0" Width="24" Height="24" Click="ManageDevices_OnClick">
                        <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </Button>
                </StackPanel>
            </Grid>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DetectedDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding ConnectionType}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                    <!-- Placeholder for VID/PID or icon if we want to expand -->
                                    <materialDesign:PackIcon Grid.Column="2" Kind="Gamepad" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right Column -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="YOUR GROUPS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,12" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DeviceGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,12" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForMapping}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  ToolTip="Use this group as the Mapping target" />
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignTextBox}" FontSize="14" FontWeight="SemiBold" />
                                        <Button Grid.Column="2" Command="{Binding RemoveGroupCommand}"
                                                Style="{StaticResource MaterialDesignToolButton}" ToolTip="Ungroup" Padding="0" Width="24" Height="24" Margin="8,0,0,0">
                                            <materialDesign:PackIcon Kind="Close" />
                                        </Button>
                                    </Grid>
                                    
                                    <ItemsControl ItemsSource="{Binding Members}" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Chip Content="{Binding DisplayName}" DeleteCommand="{Binding RemoveMemberCommand}" Margin="0,0,4,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <!-- Empty State for Groups -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeviceGroups.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <TextBlock Text="No groups created yet. Select devices on the left to group them." 
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}" FontStyle="Italic" TextWrapping="Wrap" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

    <!-- Grouping Action Bar: full app width so the message never gets squeezed, buttons anchored right. -->
    <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" Margin="0,16,0,0" Padding="12" CornerRadius="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding GroupingMessage}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Add to group ▾" Margin="0,0,8,0"
                    Click="AddToGroupButton_OnClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanAddToExistingGroup}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource MaterialDesignContextMenu}" ItemsSource="{Binding DeviceGroups}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding DataContext.AddToGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Setter Property="CommandParameter" Value="{Binding Guid}" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Grid.Column="2" Command="{Binding GroupSelectedCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Visibility="{Binding CanGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Group selected" />
                    <TextBlock Text="{Binding SelectedCount, StringFormat=' ({0})'}" />
                    <materialDesign:PackIcon Kind="ArrowRight" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
    </Grid>
</UserControl>
