<UserControl x:Class="HidWizards.UCR.Views.Mapping.MappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Mapping"
             xmlns:vm="clr-namespace:HidWizards.UCR.ViewModels.Mapping"
             xmlns:controls="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:pluginControls="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mapping Patch Bay" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold" FontSize="16"/>
                <!-- Read-only: you map one device/group at a time, committed when you pressed Begin
                     Mapping. To map something else, go back to Devices and select/Begin Mapping again
                     — not a switcher listing every device and group in the system. -->
                <TextBlock Text="Mapping:" VerticalAlignment="Center" Margin="24,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                <TextBlock Text="{Binding Dashboard.SelectedInputScope.DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Filters / Modifier Buttons: "Button/Axis to Filter" mappings don't target an output slot
             (they only set a named filter's state), so they can't be one of the Patch Bay rows below;
             this is a separate section for exactly that reason. Other rows condition on these filters
             via their own Advanced panel's "Filters:" section (PluginSummaryViewModel.FilterTags). -->
        <Expander Grid.Row="1" Header="Filters / Modifier Buttons" IsExpanded="False"
                  BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
            <StackPanel Margin="8">
                <ItemsControl ItemsSource="{Binding FilterProducers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,4" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding PluginSummary.Plugin.PluginName}" FontWeight="Bold" Opacity="0.8" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding PluginSummary.DeviceBindings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:DeviceBindingControl DataContext="{Binding}" DeviceBinding="{Binding DeviceBinding}" Label="{Binding DeviceBindingName}" Category="{Binding DeviceBindingCategory}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding PluginSummary.PluginPropertyGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="{Binding GroupName}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                        <pluginControls:PluginPropertyListControl Grid.Row="1" DataContext="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignToolButton}" Command="{Binding RemoveCommand}"
                                            Content="✕" Width="32" Height="32" Foreground="Red" ToolTip="Remove this filter mapping" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource MaterialDesignBodyLight}" FontStyle="Italic" TextWrapping="Wrap"
                           Text="No filter mappings yet. Add one to gate other rows on a button or axis being held -- e.g. a modifier-key layer.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterProducers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button Content="+ BUTTON FILTER" Command="{Binding AddButtonFilterCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                    <Button Content="+ AXIS FILTER" Command="{Binding AddAxisFilterCommand}" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <TextBlock Text="Select an Output Device for this profile to begin mapping."
                                                       Margin="12" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       FontStyle="Italic" TextWrapping="Wrap" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Patch Dot -->
                                    <Ellipse Grid.Row="0" Grid.Column="0" Width="12" Height="12" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="LightGray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBound}" Value="True">
                                                    <Setter Property="Fill" Value="Green"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- Output Label -->
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TargetOutputKey}" FontSize="10" Opacity="0.6"/>
                                </StackPanel>

                                <!-- Source Picker Group -->
                                <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,12,0" MaxWidth="350">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Listen Button -->
                                    <Button Grid.Column="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding ListenCommand}"
                                            ToolTip="Click, then move an axis or press a button on your device to bind it to this output">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource PrimaryHueMidBrush}" CornerRadius="10" Margin="6,0,0,0" Padding="6,0"
                                                            Visibility="{Binding DataContext.IsMerged, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="+1" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                <Setter Property="Content" Value="Unassigned (move axis or press button to bind)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                        <Setter Property="Content" Value="Listening … press a button…" />
                                                        <Setter Property="Foreground" Value="DeepSkyBlue" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBound}" Value="True">
                                                        <Setter Property="Content" Value="{Binding PrimarySourceDisplayName}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Chevron Manual Picker -->
                                    <Menu Grid.Column="1" Padding="0" Margin="4,0,0,0" ToolTip="Pick input manually instead of pressing it">
                                        <MenuItem Header="▾" Width="32" Height="32" FontSize="16" ItemsSource="{Binding ManualPickerMenu}"
                                                  Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                  BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="{x:Type MenuItem}">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="ItemsSource" Value="{Binding Children}" />
                                                    <Setter Property="Command" Value="{Binding MenuCommand}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                    </Menu>

                                    <!-- Clear Button -->
                                    <Button Grid.Column="2" 
                                            Style="{StaticResource MaterialDesignToolButton}" 
                                            Command="{Binding ClearCommand}"
                                            Visibility="{Binding IsBound, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Content="✕" Width="32" Height="32" Margin="4,0,0,0" Foreground="Red" ToolTip="Clear binding"/>
                                </Grid>

                                <!-- Live Indicator -->
                                <ProgressBar Grid.Row="0" Grid.Column="3" Value="{Binding InputValue, Mode=OneWay}" Height="8" VerticalAlignment="Center" Margin="0,0,12,0"
                                             Visibility="{Binding IsAxis, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Border Grid.Row="0" Grid.Column="3" Width="20" Height="20" CornerRadius="10" 
                                        BorderBrush="Gray" BorderThickness="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAxis}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Curve Status -->
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="—" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.6"/>

                                <!-- Advanced Toggle -->
                                <ToggleButton Grid.Row="0" Grid.Column="5" Style="{StaticResource MaterialDesignToolButton}" IsChecked="{Binding IsAdvancedExpanded}" Content="⋯"
                                              ToolTip="Advanced: view or edit merged inputs and plugin properties for this output" />
                                
                                <!-- Advanced Panel -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" 
                                        Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="{DynamicResource MaterialDesignPaper}" Margin="0,12,0,0" Padding="12"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4">
                                    <ItemsControl ItemsSource="{Binding Plugins}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{Binding Plugin.PluginName}" FontWeight="Bold" Margin="0,0,0,8" Opacity="0.8"/>

                                                    <!-- Output Nodes -->
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding DeviceBindings}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <controls:DeviceBindingControl DataContext="{Binding}" DeviceBinding="{Binding DeviceBinding}" Label="{Binding DeviceBindingName}" Category="{Binding DeviceBindingCategory}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Plugin Properties -->
                                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding PluginPropertyGroups}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,8,0,0">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0" Text="{Binding GroupName}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                                    <pluginControls:PluginPropertyListControl Grid.Row="1" DataContext="{Binding}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Filters: only run this plugin when a named filter (set by a Button/Axis
                                                         to Filter mapping elsewhere in the profile) is in a given state. -->
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Filters:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" FontWeight="SemiBold"/>
                                                        <ItemsControl ItemsSource="{Binding FilterTags}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                                                                        <ToggleButton IsChecked="{Binding Negative}" Content="NOT"
                                                                                      Style="{StaticResource MaterialDesignToolButton}"
                                                                                      ToolTip="Invert: only active while this filter is OFF"
                                                                                      Padding="4,0" Margin="0,0,2,0"/>
                                                                        <materialDesign:Chip Content="{Binding Name}" DeleteCommand="{Binding RemoveCommand}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Content="+ ADD FILTER" Command="{Binding AddFilterCommand}"
                                                                Style="{StaticResource MaterialDesignRaisedButton}" Padding="8,0" Margin="8,0,0,0"
                                                                ToolTip="Only run this plugin when a named filter is in a given state"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
