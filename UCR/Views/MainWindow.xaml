<Window x:Class="HidWizards.UCR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dashboard="clr-namespace:HidWizards.UCR.ViewModels.Dashboard"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:HidWizards.UCR.Views.Controls"
        xmlns:dialogs="clr-namespace:HidWizards.UCR.Views.Dialogs"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:converter="clr-namespace:HidWizards.UCR.Utilities.Converter"
        xmlns:devices="clr-namespace:HidWizards.UCR.Views.Devices"
        xmlns:mapping="clr-namespace:HidWizards.UCR.Views.Mapping"
        mc:Ignorable="d"
        ResizeMode="CanResize" 
        BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
        BorderThickness="1"
        Title="Universal Control Remapper" 
        Height="600" MinHeight="400" Width="800" MinWidth="600"
        Closing="MainWindow_OnClosing"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        PreviewMouseWheel="MainWindow_OnPreviewMouseWheel"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="5"
            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converter:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <DataTemplate x:Key="DeviceBadgeTemplate">
                <Border MinWidth="31" Height="22" Padding="5 1" CornerRadius="4"
                        Background="#1B1B1B" BorderBrush="{Binding OutlineBrush}" BorderThickness="1"
                        ToolTip="{Binding ToolTip}">
                    <TextBlock Text="{Binding BadgeText}" Foreground="{Binding AccentBrush}"
                               FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type dashboard:DeviceItem}">
                <StackPanel Margin="4">
                    <TextBlock Margin="4" Text="{Binding Title}" Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                    <TextBlock Margin="4" Text="{Binding ProviderName}" Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                </StackPanel>
            </DataTemplate>
            <Style x:Key="EmptyDeviceTrigger" TargetType="{x:Type ListView}" BasedOn="{StaticResource MaterialDesignListView}">
                <Style.Triggers>
                    <Trigger  Property="HasItems" Value="False">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Margin="4">Click</TextBlock>
                                        <materialDesign:PackIcon Kind="Plus" Height="16" Width="16" Margin="0 4"/>
                                        <TextBlock Margin="4">to add a device</TextBlock>
                                    </StackPanel>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Save" Executed="Save_OnExecuted" CanExecute="Save_OnCanExecute" />
    </Window.CommandBindings>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{DynamicResource UcrUiScale}" ScaleY="{DynamicResource UcrUiScale}"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WindowBar Grid.Row="0"/>
        <Grid x:Name="MainToolbarHost" Grid.Row="1">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource MaterialDesignShadowBrush}"
                    BorderThickness="0 0 0 1"
                    CornerRadius="2">
                <Border.Effect>
                    <BlurEffect Radius="6"/>
                </Border.Effect>
            </Border>
            <ToolBarTray Style="{DynamicResource MaterialDesignToolBarTray}" IsEnabled="{Binding Source={x:Reference RootDialog}, Path=IsOpen, Converter={StaticResource InverseBooleanConverter}}">
                <ToolBar ToolBarTray.IsLocked="True" Style="{DynamicResource MaterialDesignToolBar}" ClipToBounds="False">
                    <!-- VIEW SWITCH (Devices | Mapping) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <RadioButton x:Name="DevicesViewRadio" Content="Devices" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4,0" IsChecked="True"/>
                        <RadioButton x:Name="MappingViewRadio" Content="Mapping" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="4,0"/>
                    </StackPanel>

                    <!-- INPUT SCOPE DROPDOWN (Devices catalog) -->
                    <ComboBox x:Name="InputScopeCombo" 
                              materialDesign:HintAssist.Hint="INPUT SCOPE"
                              Width="180" Margin="0,0,16,0"
                              ItemsSource="{Binding InputSources}"
                              SelectedItem="{Binding SelectedInputScope}"
                              DisplayMemberPath="DisplayName" />

                    <!-- GAME PROFILE CHIP -->
                    <Button x:Name="GameProfileBtn" Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Click="GameProfile_OnClick"
                            Margin="0,0,16,0"
                            BorderBrush="{DynamicResource PrimaryHueMidBrush}" 
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            ToolTip="Select or create a game profile">
                        <Button.Content>
                            <TextBlock Text="{Binding SelectedProfileItem.Title, TargetNullValue='+ Press to create game profile', FallbackValue='+ Press to create game profile'}"/>
                        </Button.Content>
                    </Button>

                    <!-- OUTPUT DEVICE DROPDOWN -->
                    <ComboBox x:Name="OutputDeviceCombo" 
                              materialDesign:HintAssist.Hint="OUTPUT DEVICE"
                              Width="180" Margin="0,0,16,0"
                              ItemsSource="{Binding OutputDeviceControlViewModel.Devices}"
                              SelectedItem="{Binding OutputDeviceControlViewModel.SelectedDeviceConfiguration}"
                              DisplayMemberPath="Title" />

                    <Separator Margin="8,0" />

                    <Button ToolTip="Save" Command="Save" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ContentSave"/>
                    </Button>
                    <Button IsEnabled="{Binding CanActivateProfile}" ToolTip="Activate profile" Click="ActivateProfile" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Play"/>
                    </Button>
                    <Button IsEnabled="{Binding CanDeactivateProfile}" ToolTip="Stop active profile" Click="DeactivateProfile" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Stop"/>
                    </Button>

                    <Separator Margin="8,0" />
                    
                    <Button ToolTip="Import / Export" Click="ImportExport_OnClick" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="FileExport"/>
                    </Button>
                    <Button ToolTip="Manage devices" Click="ManageDevices_OnClick" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Settings"/>
                    </Button>
                    <Button x:Name="AppearanceButton" ToolTip="Appearance" Click="Appearance_OnClick" Padding="8 0" Margin="0,0,4,0">
                        <Grid Width="20" Height="20">
                            <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryHueMidBrush}" Stroke="#D8D8D8" StrokeThickness="1"/>
                            <Ellipse Width="5" Height="5" Fill="#212121" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button ToolTip="More" Click="ContextMenuButton_OnClick" Padding="8 0">
                        <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20"/>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource MaterialDesignContextMenu}">
                                <MenuItem Header="Open diagnostic logs" Click="OpenLogs_OnClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </ToolBar>
            </ToolBarTray>
            <Popup x:Name="AppearancePopup"
                   PlacementTarget="{Binding ElementName=AppearanceButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   Opened="AppearancePopup_OnOpened"
                   Closed="AppearancePopup_OnClosed">
                <dialogs:AppearanceDialog x:Name="AppearancePicker"
                                          AccentSelected="AppearancePicker_OnAccentSelected"
                                          CancelRequested="AppearancePicker_OnCancelRequested"/>
            </Popup>
        </Grid>
        <materialDesign:DialogHost x:Name="RootDialog" Grid.Row="2" Identifier="RootDialog">
            <Grid x:Name="PatchBayHost">
                <devices:DevicesView x:Name="DevicesViewElement" Visibility="{Binding ElementName=DevicesViewRadio, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <mapping:MappingView x:Name="MappingViewElement" Visibility="{Binding ElementName=MappingViewRadio, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</Window>
