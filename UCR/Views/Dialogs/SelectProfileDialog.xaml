<UserControl x:Class="HidWizards.UCR.Views.Dialogs.SelectProfileDialog"
             Style="{StaticResource UcrDialogRoot}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wpf="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:dialogs="clr-namespace:HidWizards.UCR.ViewModels.Dialogs"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:SelectProfileDialogViewModel}"
             d:DesignHeight="450" d:DesignWidth="420">
    <!-- This whole dialog is itself shown via DialogHost.Show(..., "RootDialog") (MainWindow.xaml.cs's
         ShowSelectProfileDialog). CREATE now immediately opens AddDevicesDialog for the new profile's
         output device — that needs a different DialogHost identifier than "RootDialog", which can only
         have one dialog open at a time. Safe to wrap the whole content here (unlike ProfileEditDialog):
         every button in this dialog closes via a ViewModel command routed through CloseDialogAction's
         explicit DialogHost.CloseDialogCommand.Execute(action, dialog) target, not an unqualified
         Command="{x:Static wpf:DialogHost.CloseDialogCommand}" on the button itself, so nothing here
         resolves its close command by searching this control's own ancestors. -->
    <wpf:DialogHost Identifier="SelectProfileNestedDialogHost">
    <Grid Margin="16" Width="380">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Select a Game Profile" Style="{DynamicResource MaterialDesignSubheadingTextBlock}" Margin="0 0 0 8" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                 DisplayMemberPath="Title"
                 Background="{DynamicResource MaterialDesignPaper}"
                 Foreground="{DynamicResource MaterialDesignBody}"
                 BorderBrush="{DynamicResource MaterialDesignDivider}" />

        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0 8 0 16"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Command="{Binding SelectCommand}" Content="USE SELECTED PROFILE" />

        <TextBlock Grid.Row="3" Text="Or create a new one:" Style="{DynamicResource MaterialDesignBody1TextBlock}" Margin="0 0 0 8" />

        <Grid Grid.Row="4" Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding GameExecutablePath, TargetNullValue='No executable selected (optional)', FallbackValue='No executable selected (optional)'}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="12" />
            <Button Grid.Column="1" Margin="8 0 0 0" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding BrowseExecutableCommand}" Content="BROWSE FOR GAME .EXE" />
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" wpf:HintAssist.Hint="New profile name"
                     Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                     Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Margin="8 0 0 0" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding CreateCommand}" Content="CREATE" />
        </Grid>

        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0 16 0 0">
            <Button Style="{DynamicResource MaterialDesignFlatButton}" Command="{Binding CancelCommand}" Content="CANCEL" />
        </StackPanel>
    </Grid>
    </wpf:DialogHost>
</UserControl>
