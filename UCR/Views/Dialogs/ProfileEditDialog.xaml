<UserControl x:Class="HidWizards.UCR.Views.Dialogs.ProfileEditDialog"
             Style="{StaticResource UcrDialogRoot}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:wpf="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Dialogs"
             xmlns:viewModels="clr-namespace:HidWizards.UCR.ViewModels.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="450"
             d:DataContext="{d:DesignInstance Type=viewModels:ProfileEditDialogViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Edit Profile" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" Margin="0 0 0 16" />

        <!-- Rename Profile -->
        <TextBox x:Name="TextValue" wpf:HintAssist.Hint="Profile Name" Style="{DynamicResource MaterialDesignFloatingHintTextBox}"                 
                 Margin="0 0 0 16"
                 FontSize="18" Grid.Row="1">
            <TextBox.Text>
                <Binding Path="ProfileName" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <local:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <!-- Auto-Activate Applications -->
        <GroupBox Header="Auto-Activate Applications" Grid.Row="2" Style="{DynamicResource MaterialDesignCardGroupBox}" Margin="0 0 0 16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding AutoActivateApplications}" SelectedItem="{Binding SelectedApplicationRule}"
                         MinHeight="100" Margin="0 0 0 8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" Width="350"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="ADD" Command="{Binding AddApplicationRuleCommand}" Margin="0 0 8 0" />
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="BROWSE" Command="{Binding BrowseApplicationRuleCommand}" Margin="0 0 8 0" />
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="REMOVE" Command="{Binding RemoveApplicationRuleCommand}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <GroupBox Header="Actions" Grid.Row="3" Style="{DynamicResource MaterialDesignCardGroupBox}" Margin="0 0 0 16">
            <WrapPanel Orientation="Horizontal" Margin="0 8 0 0">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="CLONE" Command="{Binding CloneCommand}" Margin="0 0 8 8" />
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="ADD CHILD" Command="{Binding AddChildCommand}" Margin="0 0 8 8" />
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="IMPORT CHILD" Command="{Binding ImportChildCommand}" Margin="0 0 8 8" />
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="EXPORT" Command="{Binding ExportCommand}" Margin="0 0 8 8" />
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="REMOVE" Command="{Binding RemoveCommand}" Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}" Margin="0 0 8 8" />
            </WrapPanel>
        </GroupBox>

        <!-- Dialog Controls -->
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="4" Margin="0 16 0 0">
            <Button IsDefault="True" 
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}" 
                    Content="SAVE">
                <Button.CommandParameter>
                    <system:String>Save</system:String>
                </Button.CommandParameter>
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Reference TextValue}, Path=Text}" Value="">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button IsCancel="True" Margin="8 0 0 0" Style="{DynamicResource MaterialDesignFlatButton}"
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}"
                    Content="CANCEL">
                <Button.CommandParameter>
                    <system:String>Cancel</system:String>
                </Button.CommandParameter>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
